{
  "id": "intent-accuracy-v1",
  "name": "Intent Accuracy v1",
  "description": "Evaluates how accurately the intent engine classifies user utterances across common intent categories.",
  "category": "intent_accuracy",
  "cases": [
    {
      "id": "intent-001",
      "name": "Create landing page intent",
      "input": {
        "type": "intent_pair",
        "utterance": "I need a landing page for my new SaaS product",
        "expected_intent": "create_landing"
      },
      "expected": {
        "type": "field_match",
        "checks": [{ "field": "intent", "expected": "create_landing" }]
      },
      "weight": 1.0,
      "timeout_secs": 10
    },
    {
