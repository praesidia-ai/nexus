# ─── Required in production ─────────────────────────────────────────────────
# JWT/token signing secret — MUST be a long random string (>= 32 bytes).
# Generate one with: openssl rand -hex 32
NEXUS_JWT_SECRET=

# Encrypts vault secrets + LLM API keys at rest. Same rule — generate a
# random 32+ byte string with: openssl rand -hex 32
NEXUS_ENCRYPTION_KEY=

# At least one LLM provider key is needed for generation features.
# If both are empty, the server still boots and serves the UI, but LLM
# calls fail at runtime. You can also configure these in the Settings page
# at runtime, which takes precedence over env vars.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── CORS / networking ──────────────────────────────────────────────────────
# Frontend dev/prod runs on :8080 by default; backend API runs on :8020.
# Keep legacy dev ports for users coming from older setups.
NEXUS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:3001
NEXUS_PORT=8020
NEXUS_DATA_DIR=              # default: ~/.nexus

# ─── LLM defaults ───────────────────────────────────────────────────────────
NEXUS_MODEL=gpt-4o           # or claude-sonnet-4-6, ollama/llama3.3, etc.

# ─── Observability ──────────────────────────────────────────────────────────
NEXUS_LOG_LEVEL=info         # trace | debug | info | warn | error
NEXUS_LOG_FORMAT=            # set "json" to emit structured logs for Loki/DD
NEXUS_OTEL_ENABLED=          # "true" to export OTel traces
OTEL_SERVICE_NAME=nexus-http
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── Behaviour / pipeline ──────────────────────────────────────────────────
NEXUS_SHUTDOWN_DRAIN_SECS=5              # grace period for in-flight SSE streams
NEXUS_NPM_INSTALL_TIMEOUT_SECS=300       # hard cap on auto-start npm install

# ─── Local LLM (Ollama) ─────────────────────────────────────────────────────
NEXUS_LOCAL_LLM_URL=http://localhost:11434
NEXUS_LOCAL_LLM_MODEL=llama3.3

# ─── Dev-only ───────────────────────────────────────────────────────────────
NEXUS_AUTH_DISABLED=         # set "true" to bypass auth in local dev ONLY
NEXUS_PROFILE=               # cloud | edge | micro

# ─── Federation (optional) ──────────────────────────────────────────────────
NEXUS_FEDERATION_ID=
NEXUS_PUBLIC_URL=
NEXUS_REGISTRY=
